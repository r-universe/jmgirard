	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "ackwards"]
	path = ackwards
	url = https://github.com/jmgirard/ackwards
[submodule "circumplex"]
	path = circumplex
	url = https://github.com/jmgirard/circumplex
[submodule "rlmstudio"]
	path = rlmstudio
	url = https://github.com/jmgirard/rlmstudio
